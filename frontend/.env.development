# 开发环境配置
NODE_ENV=development

# API网关地址
VITE_API_GATEWAY=http://localhost:8080

# 微服务地址
VITE_USER_SERVICE=http://localhost:8081
VITE_PET_SERVICE=http://localhost:8082
VITE_ACTIVITY_SERVICE=http://localhost:8083
VITE_MEDICAL_SERVICE=http://localhost:8084
VITE_SHOP_SERVICE=http://localhost:8085

# 应用配置
VITE_APP_TITLE=宠物护理生态系统 - 开发版
VITE_APP_VERSION=1.0.0

# 功能开关
VITE_ENABLE_MOCK=true
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false

# 开发工具
VITE_ENABLE_VUE_DEVTOOLS=true
VITE_ENABLE_PERFORMANCE_MONITOR=true