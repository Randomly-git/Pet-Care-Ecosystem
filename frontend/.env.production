# 生产环境配置
NODE_ENV=production

# API网关地址 - 生产环境需要替换为实际地址
VITE_API_GATEWAY=https://api.petcare.com

# 微服务地址 - 生产环境通过网关访问
VITE_USER_SERVICE=/api/user
VITE_PET_SERVICE=/api/pet
VITE_ACTIVITY_SERVICE=/api/activity
VITE_MEDICAL_SERVICE=/api/medical
VITE_SHOP_SERVICE=/api/shop

# 应用配置
VITE_APP_TITLE=宠物护理生态系统
VITE_APP_VERSION=1.0.0

# 功能开关
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true

# 生产环境监控
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITOR=true

# 安全配置
VITE_ENABLE_CSP=true
VITE_ENABLE_XSS_PROTECTION=true