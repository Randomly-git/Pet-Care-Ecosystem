type Query {
    activityHealthAnalysis(petId: ID!, days: Int, userRequirement: String): AnalysisResult
    identifyCatBreed(imageData: String!): BreedResult
    aiAgent(petId: ID!, message: String!): AgentResult
}

# ========== 功能1: 活动健康分析 ==========

type AnalysisResult {
    petId: ID!
    petName: String!
    breed: String!
    species: String!
    analysis: String!
    knowledgeSources: [KnowledgeSource!]
    analysisType: String!
}

type KnowledgeSource {
    title: String!
    content: String!
    score: Float!
}

# ========== 功能2: 猫品种识别 ==========

type BreedResult {
    identifiedBreed: String!
    description: String
    characteristics: String
    confidence: Float!
    rawAnalysis: String!
}

# ========== 功能3: AI 智能体 ==========

type AgentResult {
    petId: ID!
    petName: String!
    message: String!
    toolCalls: [ToolCallLog!]
}

type ToolCallLog {
    toolName: String!
    arguments: String!
    result: String!
    success: Boolean!
}

scalar ID
